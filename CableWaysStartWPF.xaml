<Window x:Class="TNovElectrical.CableWaysStartWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovElectrical"
        mc:Ignorable="d"
        Width="350"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:CableWaysStartViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СПОСОБЫ ПРОКЛАДКИ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Text="Выберите сценарий работы"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,2,0,16"/>

            <RadioButton Style="{StaticResource CardRadioStyle}"
                         x:Name="rB1"
                         GroupName="elems"
                         IsChecked="{Binding all}">
                <TextBlock Text="Все элементы в проекте" Style="{StaticResource CardTitleStyle}"/>
            </RadioButton>
            <RadioButton Style="{StaticResource CardRadioStyle}"
                         x:Name="rB2"
                         GroupName="elems"
                         IsChecked="{Binding visible}"
                         Margin="0,0,0,16">
                <TextBlock Text="Выбранные элементы" Style="{StaticResource CardTitleStyle}"/>
            </RadioButton>

            <Button Content="Применить"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="acceptButton"
                    IsDefault="True"
                    Click="acceptButton_Click"/>
            <Button Content="Отмена"
                    Style="{StaticResource CloseButtonStyle}"
                    x:Name="escButton"
                    IsCancel="True"
                    Click="escButton_Click"/>
        </StackPanel>
    </Border>
</Window>
