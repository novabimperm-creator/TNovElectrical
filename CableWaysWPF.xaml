<Window x:Class="TNovElectrical.CableWaysWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovElectrical"
        mc:Ignorable="d"
        Width="440"
        SizeToContent="Height"
        MaxHeight="620"
        d:DataContext="{d:DesignInstance local:CableWaysViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- стикер типа трубы -->
            <Style x:Key="StickerBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TreeToggleBrush}"/>
                <Setter Property="CornerRadius" Value="13"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="10,0,4,0"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>

            <!-- мини-кнопка "х" внутри стикера -->
            <Style x:Key="StickerCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- кнопка "+" в виде стикера -->
            <Style x:Key="AddStickerButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Background" Value="{StaticResource TreeToggleBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СПОСОБЫ ПРОКЛАДКИ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Типы труб"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Значение ищется в исходной строке и записывается в параметр типа трубы"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding pipeTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StickerBorderStyle}">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="✕"
                                                Style="{StaticResource StickerCloseButtonStyle}"
                                                ToolTip="Удалить из списка"
                                                Command="{Binding DataContext.RemovePipeTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="+"
                                Style="{StaticResource AddStickerButtonStyle}"
                                ToolTip="Добавить тип трубы"
                                Click="addPipeTypeButton_Click"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding isAddingPipeType, Converter={StaticResource BoolToVis}}">
                            <TextBox x:Name="newPipeTypeBox"
                                     Width="230"
                                     Style="{StaticResource DarkCompactTextBoxStyle}"
                                     Text="{Binding newPipeType, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="newPipeTypeBox_KeyDown"/>
                            <Button Content="✓"
                                    Style="{StaticResource AddStickerButtonStyle}"
                                    Margin="6,0,0,0"
                                    ToolTip="Добавить"
                                    Click="acceptPipeTypeButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <Button Content="Применить"
                        Style="{StaticResource RunButtonStyle}"
                        x:Name="acceptButton"
                        IsDefault="True"
                        Click="acceptButton_Click"/>
                <Button Content="Отмена"
                        Style="{StaticResource CloseButtonStyle}"
                        x:Name="escButton"
                        IsCancel="True"
                        Click="escButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
