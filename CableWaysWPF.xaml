<Window x:Class="TNovElectrical.CableWaysWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovElectrical"
        mc:Ignorable="d"
        Width="720"
        SizeToContent="Height"
        MaxHeight="720"
        d:DataContext="{d:DesignInstance local:CableWaysViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СПОСОБЫ ПРОКЛАДКИ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Запись длины по способам прокладки"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="В параметр" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding sPar1}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="записать длину со способом прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding sTypePar1}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="В параметр" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding sPar2}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="записать длину со способом прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding sTypePar2}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="В параметр" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding sPar3}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="записать длину со способом прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding sTypePar3}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="В параметр" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding sPar4}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="записать длину со способом прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding sTypePar4}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="В параметр" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding sPar5}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="записать длину со способом прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding sTypePar5}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>

                    <TextBlock Text="Соотнесение типа трубы и способа прокладки"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="тип трубы" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding pipeType1}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="для способа прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding pipeWay1}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="тип трубы" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding pipeType2}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="для способа прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding pipeWay2}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="тип трубы" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding pipeType3}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="для способа прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding pipeWay3}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="тип трубы" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding pipeType4}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="для способа прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding pipeWay4}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="тип трубы" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding pipeType5}" Style="{StaticResource DarkCompactTextBoxStyle}" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="для способа прокладки" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding pipeWay5}" Style="{StaticResource DarkCompactTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <Button Content="Применить"
                        Style="{StaticResource RunButtonStyle}"
                        x:Name="acceptButton"
                        IsDefault="True"
                        Click="acceptButton_Click"/>
                <Button Content="Отмена"
                        Style="{StaticResource CloseButtonStyle}"
                        x:Name="escButton"
                        IsCancel="True"
                        Click="escButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
