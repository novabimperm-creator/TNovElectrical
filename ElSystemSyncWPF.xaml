<Window x:Class="TNovElectrical.ElSystemSyncWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TNovElectrical"
        Width="820"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        x:Name="ThisWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СИНХРОНИЗАТОР"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Имя связанного файла:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding LinkNames}"
                          SelectedItem="{Binding SelectedLinkName}"/>
                <TextBlock Grid.Column="3"
                           Text="Номер цепи:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox Grid.Column="4"
                          VerticalAlignment="Center"
                          Margin="0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding SystemNumbers}"
                          SelectedItem="{Binding SelectedSystemNumber}"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Текущий номер цепи:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         VerticalAlignment="Center"
                         Text="{Binding CurrentSystem.AnnoSystemNumber, Mode=OneWay}"
                         IsReadOnly="True"
                         Style="{StaticResource DarkTextBoxStyle}"/>
            </Grid>

            <ToggleButton Grid.Row="3"
                          Style="{StaticResource CardToggleStyle}"
                          Margin="0,0,0,10"
                          IsChecked="{Binding SelectAll}">
                <TextBlock Text="Выбрать все" Style="{StaticResource CardTitleStyle}"/>
            </ToggleButton>

            <StackPanel Grid.Row="4"
                        IsEnabled="{Binding HasCurrentSystem}"
                        Margin="0,0,0,12">
                <ToggleButton Style="{StaticResource CardToggleStyle}"
                              HorizontalContentAlignment="Stretch"
                              IsChecked="{Binding CurrentSystem.IsSelectedPy}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Py (Установленная мощность)" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentSystem.SystemPy}"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentSystem.AnnoPy}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Background="{Binding CurrentSystem.IsPyDifferent, Converter={StaticResource BoolToColorConverter}}"/>
                    </Grid>
                </ToggleButton>

                <ToggleButton Style="{StaticResource CardToggleStyle}"
                              HorizontalContentAlignment="Stretch"
                              IsChecked="{Binding CurrentSystem.IsSelectedCosf}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cosf (Коэффициент мощности)" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentSystem.SystemCosf}"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentSystem.AnnoCosf}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Background="{Binding CurrentSystem.IsCosfDifferent, Converter={StaticResource BoolToColorConverter}}"/>
                    </Grid>
                </ToggleButton>

                <ToggleButton Style="{StaticResource CardToggleStyle}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Top"
                              IsChecked="{Binding CurrentSystem.IsSelectedCableLength}">
                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="L (Длина кабеля в группе)" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding CurrentSystem.SystemConductorL1}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding CurrentSystem.SystemConductorL2}" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding CurrentSystem.SystemConductorL3}" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding CurrentSystem.AnnoConductorL1}"
                                       Foreground="White"
                                       Background="{Binding CurrentSystem.IsConductorL1Different, Converter={StaticResource BoolToColorConverter}}"/>
                            <TextBlock Text="{Binding CurrentSystem.AnnoConductorL2}"
                                       Foreground="White"
                                       Background="{Binding CurrentSystem.IsConductorL2Different, Converter={StaticResource BoolToColorConverter}}"/>
                            <TextBlock Text="{Binding CurrentSystem.AnnoConductorL3}"
                                       Foreground="White"
                                       Background="{Binding CurrentSystem.IsConductorL3Different, Converter={StaticResource BoolToColorConverter}}"/>
                        </StackPanel>
                    </Grid>
                </ToggleButton>

                <ToggleButton Style="{StaticResource CardToggleStyle}"
                              HorizontalContentAlignment="Stretch"
                              IsChecked="{Binding CurrentSystem.IsSelected3Phase}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="U (Напряжение)" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentSystem.ThreePhase}"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentSystem.Anno3PhaseDevice}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Background="{Binding CurrentSystem.Is3PhaseDifferent, Converter={StaticResource BoolToColorConverter}}"/>
                    </Grid>
                </ToggleButton>

                <ToggleButton Style="{StaticResource CardToggleStyle}"
                              HorizontalContentAlignment="Stretch"
                              IsChecked="{Binding CurrentSystem.IsSelectedLoadName}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Имя нагрузки" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentSystem.SystemLoadName}"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentSystem.AnnoDeviceName}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Background="{Binding CurrentSystem.IsLoadNameDifferent, Converter={StaticResource BoolToColorConverter}}"/>
                    </Grid>
                </ToggleButton>

                <ToggleButton Style="{StaticResource CardToggleStyle}"
                              HorizontalContentAlignment="Stretch"
                              IsChecked="{Binding CurrentSystem.IsSelectedElemsCount}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Кол-во электроприемников" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentSystem.SystemElemsCount}"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentSystem.AnnoElemsCount}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Background="{Binding CurrentSystem.IsElemsCountDifferent, Converter={StaticResource BoolToColorConverter}}"/>
                    </Grid>
                </ToggleButton>

                <ToggleButton Style="{StaticResource CardToggleStyle}"
                              HorizontalContentAlignment="Stretch"
                              Margin="0"
                              IsChecked="{Binding CurrentSystem.IsSelectedCableWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Способ прокладки" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentSystem.SystemCableWay}"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentSystem.AnnoCableWay}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Background="{Binding CurrentSystem.IsCableWayDifferent, Converter={StaticResource BoolToColorConverter}}"/>
                    </Grid>
                </ToggleButton>
            </StackPanel>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Применить" Margin="0"
                        Style="{StaticResource RunButtonStyle}"
                        Command="{Binding ApplyCommand}"
                        IsDefault="True"/>
                <Button Grid.Column="2"
                        Content="Завершить"
                        Style="{StaticResource CloseButtonStyle}"
                        Command="{Binding ExitCommand}"
                        IsCancel="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
