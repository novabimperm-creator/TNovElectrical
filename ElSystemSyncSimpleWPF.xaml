<Window x:Class="TNovElectrical.ElSystemSyncSimpleWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        x:Name="ThisWindow"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СИНХРОНИЗАТОР"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CancelButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Имя связанного файла:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="cmbLinkNames"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="0"
                          Style="{StaticResource DarkComboBoxStyle}"/>
            </Grid>

            <ToggleButton x:Name="chkSelectAll"
                          Grid.Row="2"
                          Style="{StaticResource CardToggleStyle}"
                          Margin="0,0,0,10"
                          Click="chkSelectAll_Click">
                <TextBlock Text="Выбрать все" Style="{StaticResource CardTitleStyle}"/>
            </ToggleButton>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <ToggleButton x:Name="chkPy"
                                  Style="{StaticResource CardToggleStyle}">
                        <TextBlock Text="Py (Установленная мощность)" Style="{StaticResource CardTitleStyle}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="chkCosf"
                                  Style="{StaticResource CardToggleStyle}">
                        <TextBlock Text="Cosf (Коэффициент мощности)" Style="{StaticResource CardTitleStyle}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="chkCableLength"
                                  Style="{StaticResource CardToggleStyle}">
                        <TextBlock Text="L (Длина кабеля в группе)" Style="{StaticResource CardTitleStyle}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="chk3Phase"
                                  Style="{StaticResource CardToggleStyle}">
                        <TextBlock Text="U (Напряжение)" Style="{StaticResource CardTitleStyle}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="chkLoadName"
                                  Style="{StaticResource CardToggleStyle}">
                        <TextBlock Text="Имя нагрузки" Style="{StaticResource CardTitleStyle}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="chkElemsCount"
                                  Style="{StaticResource CardToggleStyle}">
                        <TextBlock Text="Кол-во электроприемников" Style="{StaticResource CardTitleStyle}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="chkCableWay"
                                  Style="{StaticResource CardToggleStyle}"
                                  Margin="0">
                        <TextBlock Text="Способ прокладки" Style="{StaticResource CardTitleStyle}"/>
                    </ToggleButton>
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="btnCancel"
                        Content="Отмена"
                        Style="{StaticResource CloseButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button Grid.Column="2" Margin="0"
                        x:Name="btnApply"
                        Content="Применить"
                        Style="{StaticResource RunButtonStyle}"
                        IsDefault="True"
                        Click="ApplyButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
